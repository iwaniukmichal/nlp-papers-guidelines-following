# LaTeX build artifacts in docs/proposal/ (keep sources, bibliography, styles and PDFs).
/docs/proposal/*.aux
/docs/proposal/*.bbl
/docs/proposal/*.bcf
/docs/proposal/*.blg
/docs/proposal/*.dvi
/docs/proposal/*.fdb_latexmk
/docs/proposal/*.fls
/docs/proposal/*.lof
/docs/proposal/*.log
/docs/proposal/*.lot
/docs/proposal/*.nav
/docs/proposal/*.out
/docs/proposal/*.run.xml
/docs/proposal/*.snm
/docs/proposal/*.synctex.gz
/docs/proposal/*.synctex(busy)
/docs/proposal/*.toc
/docs/proposal/*.vrb
/docs/proposal/*.xdv

*.DS_STORE*
priv
.idea/
.env
*.env
__pycache__/
*.egg-info/
.venv/
.pytest_cache/

# Large or copyrighted pipeline artefacts (re-creatable with scripts/).
/data/raw/
/data/interim/
